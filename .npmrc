# legacy-peer-deps=true
# Set because vitest@5's peerDependency on @types/node@^22||>=24 conflicts
# with this project's @types/node@^20. @types/node is an optional peer of
# vitest, so there is no real incompatibility; npm's strict mode is the only
# blocker. Keep this flag while @types/node stays below vitest's declared
# peer range. Re-evaluate (and remove) if @types/node is ever bumped to a
# range that satisfies vitest directly.
legacy-peer-deps=true
